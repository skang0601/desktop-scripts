[Unit]
Description=OpenCode server (sandboxed, for the phone over Tailscale)
After=ollama.service
Wants=ollama.service

[Container]
# Pinned to the desktop app's version, so both read the same config schema.
Image=ghcr.io/anomalyco/opencode:2.2.5
Exec=serve --hostname 0.0.0.0 --port 4096

# The only host directory it can see. Projects for phone work live here;
# $HOME, ~/.ssh, the 1Password agent, keyrings, browser profiles and the desktop
# app's sessions are not mounted, so they do not exist inside.
Volume=%h/Workspace/phone:/workspace:Z
WorkingDir=/workspace

# Its own config (installed read-only by the installer: an OpenAI orchestrator
# with local subagents, every other provider denied) and its own sessions,
# OpenAI login, cache and npm packages -- nothing shared with the desktop app's
# ~/.local/share/opencode.
Volume=%h/.local/share/opencode-sandbox:/data:Z
Volume=%h/.local/share/opencode-sandbox-config:/data/.config/opencode:ro,Z
Environment=HOME=/data
Environment=XDG_CONFIG_HOME=/data/.config
Environment=XDG_DATA_HOME=/data/.local/share
Environment=XDG_CACHE_HOME=/data/.cache
Environment=XDG_STATE_HOME=/data/.local/state

# Basic auth, user "opencode". Generated by the installer, never in the repo.
EnvironmentFile=%h/.config/opencode-server/env

# Runs as this user's uid rather than the image's root, so files it writes in
# the workspace are owned normally and it holds no capability on the host.
UserNS=keep-id
DropCapability=ALL
NoNewPrivileges=true
ReadOnly=true
# notmpcopyup: podman otherwise seeds the tmpfs from the image's /tmp, which
# ships /tmp/opencode owned by root, and under keep-id the server cannot create
# its upload staging directory inside it -- every upload fails with a 500.
Tmpfs=/tmp:rw,notmpcopyup,mode=1777
# Uploads from the browser are kept under /tmp/opencode/uploads/<id>/, and the
# session refers to them by that path, so a tmpfs there would lose every
# attachment on restart while the chats still point at them.
Volume=%h/.local/share/opencode-sandbox-uploads:/tmp/opencode:Z

# Its own network namespace. pasta forwards the namespace's 127.0.0.1:11434 to
# the host's, so ollama is the one host service it reaches; every other port
# on the host's loopback (searxng, the desktop app's server) is not visible.
# Outbound internet and the LAN remain reachable.
Network=pasta:-T,11434
# Published on the host's loopback only; tailscale serve is what makes it
# reachable, from the tailnet and nowhere else.
PublishPort=127.0.0.1:4096:4096

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
